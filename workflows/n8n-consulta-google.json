{
  "name": "Observa | RPA → Google Drive + Sheets",
  "active": false,
  "nodes": [
    {
      "id": "readme",
      "name": "Configuração",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, -220],
      "parameters": {
        "content": "## Observa — configuração\n1. Edite Entrada: URL da API e termo.\n2. Nos dois HTTP Request, selecione uma credencial Header Auth: X-API-Key.\n3. Configure OAuth/Drive/Sheets no servidor (docs/bonus-google.md).\n4. Execute o fluxo. A etapa Google chama o exportador Python, que usa as APIs oficiais e retoma uploads.\n\nO status da coleta e o status do arquivamento são separados. CAPTCHA arquivado continua sendo erro de coleta. Não reexecute a consulta para repetir somente o upload.",
        "height": 280,
        "width": 720
      }
    },
    {
      "id": "manual",
      "name": "Executar consulta",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 140],
      "parameters": {}
    },
    {
      "id": "input",
      "name": "Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 140],
      "parameters": {
        "jsCode": "return [{ json: { api_url: 'https://portfolio.ecommjet.com.br', termo: 'TESTE INEXISTENTE MOSTQI XYZ', beneficiario_programa_social: false } }];"
      }
    },
    {
      "id": "robot",
      "name": "Consultar RPA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 140],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/consultas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { termo: $json.termo, beneficiario_programa_social: $json.beneficiario_programa_social } }}",
        "options": {
          "timeout": 180000,
          "redirect": { "redirect": { "followRedirects": false } },
          "response": { "response": { "neverError": true, "responseFormat": "json" } }
        }
      }
    },
    {
      "id": "validate",
      "name": "Validar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 140],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (!result.consulta_id || !result.consultado_em || !['sucesso', 'parcial', 'erro'].includes(result.status)) {\n  throw new Error('A API não devolveu uma consulta válida. Confira URL, autenticação e entrada.');\n}\nreturn [{ json: result }];"
      }
    },
    {
      "id": "archive",
      "name": "Arquivar no Drive e Sheets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 140],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Entrada\"].json.api_url }}/integracoes/google/arquivar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 300000,
          "redirect": { "redirect": { "followRedirects": false } },
          "response": { "response": { "responseFormat": "json" } }
        }
      }
    },
    {
      "id": "receipt",
      "name": "Recibo da execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 140],
      "parameters": {
        "jsCode": "const result = $('Validar resultado').first().json;\nreturn [{ json: { status_coleta: result.status, codigo_coleta: result.codigo, status_arquivamento: 'concluido', ...$input.first().json } }];"
      }
    }
  ],
  "connections": {
    "Executar consulta": { "main": [[{ "node": "Entrada", "type": "main", "index": 0 }]] },
    "Entrada": { "main": [[{ "node": "Consultar RPA", "type": "main", "index": 0 }]] },
    "Consultar RPA": { "main": [[{ "node": "Validar resultado", "type": "main", "index": 0 }]] },
    "Validar resultado": { "main": [[{ "node": "Arquivar no Drive e Sheets", "type": "main", "index": 0 }]] },
    "Arquivar no Drive e Sheets": { "main": [[{ "node": "Recibo da execução", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "tags": []
}
